# Content Generator Workforce — Environment Configuration
# Copy this file to .env and fill in your values

# ============================================================
# Local LLM (Ollama)
# ============================================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_PORT=11434

# ============================================================
# Composio — Tool Infrastructure
# ============================================================
COMPOSIO_API_KEY=ak_LaSxRjXstfYVi7cwdV2g
# COMPOSIO_REDIRECT_URI=https://your-app.com/auth/callback

# ============================================================
# Airtable — Structured Database
# ============================================================
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=

# ============================================================
# Google Drive — Cloud Files
# ============================================================
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://your-app.com/auth/google/callback

# ============================================================
# OpenAI (Optional — for GPT-based agents)
# ============================================================
# OPENAI_API_KEY=

# ============================================================
# Obsidian — Knowledge Base
# ============================================================
OBSIDIAN_VAULT_PATH=/home/brettanthonysjoberg179/Documents/Obsidian Vault

# ============================================================
# Application Settings
# ============================================================
WORKFORCE_PORT=8000
WORKFORCE_HOST=0.0.0.0
LOG_LEVEL=INFO
ENVIRONMENT=development

# ============================================================
# Security
# ============================================================
# JWT_SECRET_KEY=
# SESSION_SECRET_KEY=

# ============================================================
# MCP Server
# ============================================================
# MCP_SERVER_MODE=stdio  # or http
# MCP_SERVER_PORT=8000

# ============================================================
# Database (Optional — PostgreSQL for production)
# ============================================================
# DATABASE_URL=postgresql://user:password@localhost:5432/workforce
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_DB=workforce
EOF
echo "Created .env.example"
